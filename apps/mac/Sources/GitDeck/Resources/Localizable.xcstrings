    "ai.empty": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review local changes, commits from the Git log, or the current branch against another branch. Results appear here and in the editor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可以评审本地更改、Git 日志中的提交，或当前分支相对其他分支的改动。结果显示在这里和编辑器中。"
          }
        }
      }
    },
