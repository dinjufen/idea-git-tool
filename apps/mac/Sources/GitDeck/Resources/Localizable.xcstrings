    "ai.apply.notFound.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The code it refers to has changed since the review. Rerun the review or edit the file manually."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "评审之后相关代码已经改变。请重新评审或手动修改文件。"
          }
        }
      }
    },
    "ai.apply.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apply AI Suggestion to %1$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将 AI 建议应用到 %1$@"
          }
        }
      }
    },
    "ai.consent.allow": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow for This Project"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许此项目"
          }
        }
      }
    },
    "ai.consent.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To review \"%1$@\", GitDeck sends the changes under review and, when the model asks for them, other files of this project to %2$@. Files matching the sensitive-file rules are never sent. You'll be asked again for other projects or services."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为了评审“%1$@”，GitDeck 会把待评审的改动以及模型请求读取的其他项目文件发送到 %2$@。匹配敏感文件规则的文件不会发送。对其他项目或服务会再次询问。"
          }
        }
      }
    },
    "ai.consent.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send code to %1$@?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将代码发送到 %1$@？"
          }
        }
      }
    },
    "ai.done.none": {
      "extractionState": "manual",
