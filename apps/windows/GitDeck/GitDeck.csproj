<Project Sdk="Microsoft.NET.Sdk">

  <!-- WinUI 3 应用：非打包、自包含（见 docs/DECISIONS.md 第 13、15、17 项）。 -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>GitDeck</RootNamespace>
    <AssemblyName>GitDeck</AssemblyName>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/GitDeck.ico</ApplicationIcon>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- 只发布界面支持的语言（英文与简体中文）的 .NET 资源。 -->
    <SatelliteResourceLanguages>en;zh-Hans</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../GitDeck.Core/GitDeck.Core.csproj" />
    <!-- 编辑器组件（docs/DECISIONS.md 第 14 项）：从 Vendor/WinUIEdit 源码编译，C# 投影见 GitDeck.Editor。 -->
    <ProjectReference Include="../GitDeck.Editor/GitDeck.Editor.csproj" />
    <!-- askpass 程序与主程序放在同一目录（核心通过 GIT_ASKPASS / SSH_ASKPASS 调用它）。 -->
    <ProjectReference Include="../GitDeck.AskPass/GitDeck.AskPass.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- 界面文案与 mac 端共用同一份 xcstrings（见 Common/L10n.cs）。 -->
    <EmbeddedResource Include="../../mac/Sources/GitDeck/Resources/Localizable.xcstrings" LogicalName="Localizable.xcstrings" />
    <Content Include="Assets/**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="CopyAskPass" AfterTargets="Build">
    <ItemGroup>
      <AskPassFiles Include="../GitDeck.AskPass/bin/$(Configuration)/net10.0-windows/GitDeck.AskPass.*" />
    </ItemGroup>
    <Copy SourceFiles="@(AskPassFiles)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>
